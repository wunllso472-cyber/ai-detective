# 元宝搜索（腾讯云 wsa）：控制台 → 访问管理 → API 密钥
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# WSA_ENDPOINT=wsa.tencentcloudapi.com
# SEARCH_CONCURRENCY=3
# SEARCH_CACHE_MINUTES=30

# 火山引擎方舟：控制台 → API Key 管理；模型填模型 ID 或推理接入点 ID（ep-xxxx）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-1-pro-260915
# 截图查证用的视觉模型，不填则与 ARK_MODEL 相同（需支持图片输入）
ARK_VISION_MODEL=
# doubao-seed 系列默认关闭深度思考以提速；需要时设为 enabled
# ARK_THINKING=disabled

# 盯梢：调度器每隔多少秒检查一次到期任务；新任务默认检查间隔（分钟）
# WATCH_TICK_SECONDS=60
# WATCH_INTERVAL_MINUTES=60

# 不填密钥时自动进入模拟模式；也可强制：MOCK_SEARCH=1 / MOCK_LLM=1
